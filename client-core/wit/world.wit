package experiment:mosh-client;

/// The client-core glue (D7/B2): the composition seam between the pure
/// sync mosh engine and the async polymorph-iroh endpoint. It owns the
/// only async parts of the client — the recv-datagram loop and the
/// ~8 ms tick — and exposes one driver surface to the embedder.
interface client {
  use experiment:mosh/engine.{session-stats};

  resource client-session {
    /// Full proxy flow, self-contained (native harness, proxy
    /// tooling): generate a throwaway identity, bind (UDP direct
    /// enabled, `relay-url` as home relay), dial `peer-id-hex`
    /// (`direct` is an `ip:port` hint), run the control channel
    /// (hello with `pairing-token`, new-session), and start the mosh
    /// engine with the delivered key. Datagrams use the proxy tunnel
    /// framing (sub-framing for oversized server datagrams).
    connect-proxy: static async func(relay-url: string, peer-id-hex: string, direct: option<string>, pairing-token: string, cols: u16, rows: u16) -> result<client-session, string>;

    /// Raw-datagram shape for harnesses and interop peers that pump
    /// unframed mosh datagrams (the M3 gate): dial as above but skip
    /// the control channel and tunnel framing; the mosh key is already
    /// in hand.
    dial: static async func(relay-url: string, peer-id-hex: string, direct: option<string>, key: string, cols: u16, rows: u16) -> result<client-session, string>;

    /// Inner-ssh flow (M7, workstream F): dial the proxy, hello, open
    /// an ssh-forward stream to sshd on the proxy host's loopback,
    /// authenticate (password v0; sent only after the host key is
    /// approved), run `mosh-command` (default `mosh-server new -i
    /// 127.0.0.1 -c 256`), parse `MOSH CONNECT <port> <key>` from its
    /// output, route the connection's datagram tunnel to that port,
    /// and start the engine. The proxy never sees the key (D2 end
    /// state). Host-key policy: `expected-host-key` some(fp) must
    /// match the server's base64 SHA-256 or the flow fails before
    /// authentication; none accepts and reports (TOFU first contact —
    /// read ssh-host-key and pin it).
    connect-ssh: static async func(relay-url: string, peer-id-hex: string, direct: option<string>, pairing-token: string, user: string, password: string, expected-host-key: option<string>, mosh-command: option<string>, cols: u16, rows: u16) -> result<client-session, string>;

    /// Queue keystrokes (prediction overlay surfaces via drain-output).
    feed-keys: async func(keys: list<u8>);

    /// Propagate a terminal resize.
    resize: async func(cols: u16, rows: u16);

    /// Drain accumulated display bytes (ANSI, pre-diffed).
    drain-output: async func() -> list<u8>;

    stats: async func() -> session-stats;

    /// The connection's current datagram ceiling (engine wire maximum
    /// is 1138 B; the embedder may assert headroom).
    max-datagram-size: async func() -> option<u32>;

    /// The transport currently carrying the connection: "relay",
    /// "ip", or "webrtc". Not latched: a relay-dialed connection
    /// upgrades to the data channel in the background once it opens
    /// (and falls back if it dies) — poll to observe the move.
    path: async func() -> string;

    /// The proxy-assigned session id (none on the `dial` path).
    session-id: async func() -> option<u64>;

    /// The ssh server's host key fingerprint (base64 SHA-256), on the
    /// connect-ssh path once kex reached it. Pin it (embedder
    /// storage) and pass it as expected-host-key next time.
    ssh-host-key: async func() -> option<string>;

    /// The session's mosh key. For embedder-side persistence only
    /// (D4): wrap it (PRF arm) or store it (plain arm) together with
    /// a sequence floor from `stats.current-seq` — never send it
    /// anywhere in plaintext.
    session-key: async func() -> string;

    /// Passkey ceremonies (M6), passed through the control channel;
    /// the embedder owns the authenticator. Returns the webauthn-rs
    /// `CreationChallengeResponse` JSON.
    register-start: async func() -> result<list<u8>, string>;

    /// Complete registration with the authenticator's
    /// `RegisterPublicKeyCredential` JSON.
    register-finish: async func(response: list<u8>) -> result<_, string>;

    /// Escrow the embedder-wrapped blob on the proxy and mark the
    /// session persistent (survives detach; reattach is
    /// assertion-gated). Requires a completed registration.
    make-persistent: async func(escrow: list<u8>) -> result<_, string>;

    /// Stop the pumps and close the connection. The mosh session on
    /// the server survives iff persistent (finding 13 governs
    /// reattach).
    detach: async func();
  }

  /// Reattach to a persistent session (M6). Two phases because the
  /// embedder unwraps the escrow between assertion and engine start:
  /// begin → challenge → (embedder runs the authenticator) → finish
  /// returns the escrow blob → (embedder unwraps key, bumps the
  /// sequence floor forward) → attach starts the engine on the
  /// already-authorized connection. Drop the flow after attach.
  resource reattach-flow {
    begin: static async func(relay-url: string, peer-id-hex: string, direct: option<string>, pairing-token: string, session-id: u64) -> result<reattach-flow, string>;

    /// The webauthn-rs `RequestChallengeResponse` JSON.
    challenge: async func() -> list<u8>;

    /// Send the assertion (`PublicKeyCredential` JSON); resolves with
    /// the escrow blob.
    finish: async func(assertion: list<u8>) -> result<list<u8>, string>;

    /// `initial-seq` must be strictly above the escrowed floor.
    attach: async func(key: string, initial-seq: u64, cols: u16, rows: u16) -> result<client-session, string>;
  }
}

/// The embedder-owned-endpoint shape (the browser client, M5): the
/// embedder binds/dials — identity persistence, bootstrap, and path
/// choice stay embedder policy — then hands the connection over; the
/// glue runs the control channel and the session, and owns the
/// connection from there (close on detach). Split from `client`
/// because this is the one function whose signature names endpoint
/// types: hosts of the composed artifact can bind against `client`
/// alone without resolving the fused-away endpoint import.
interface embed {
  use polymorph:iroh/endpoint@0.1.0.{connection};
  use client.{client-session};

  attach-proxy: async func(conn: connection, pairing-token: string, cols: u16, rows: u16) -> result<client-session, string>;
}

/// The glue component's own world (what client-core builds against).
world client-world {
  import experiment:mosh/engine;
  import experiment:mosh/ssh;
  import polymorph:iroh/identity-generate@0.1.0;
  import polymorph:iroh/endpoint@0.1.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  export client;
  export embed;
}

/// The composed artifact as a native host sees it (bindgen view for
/// the harness; the engine and endpoint are fused inside, `embed` is
/// deliberately out of view).
world composed-client {
  export client;
}
