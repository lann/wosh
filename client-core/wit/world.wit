package experiment:mosh-client;

/// The client-core glue (D7/B2): the composition seam between the pure
/// sync mosh engine and the async polymorph-iroh endpoint. It owns the
/// only async parts of the client — the recv-datagram loop and the
/// ~8 ms tick — and exposes one driver surface to the embedder.
interface client {
  use experiment:mosh/engine.{session-stats};

  resource client-session {
    /// Full proxy flow, self-contained (native harness, proxy
    /// tooling): generate a throwaway identity, bind (UDP direct
    /// enabled, `relay-url` as home relay), dial `peer-id-hex`
    /// (`direct` is an `ip:port` hint), run the control channel
    /// (hello with `pairing-token`, new-session), and start the mosh
    /// engine with the delivered key. Datagrams use the proxy tunnel
    /// framing (sub-framing for oversized server datagrams).
    connect-proxy: static async func(relay-url: string, peer-id-hex: string, direct: option<string>, pairing-token: string, cols: u16, rows: u16) -> result<client-session, string>;

    /// Raw-datagram shape for harnesses and interop peers that pump
    /// unframed mosh datagrams (the M3 gate): dial as above but skip
    /// the control channel and tunnel framing; the mosh key is already
    /// in hand.
    dial: static async func(relay-url: string, peer-id-hex: string, direct: option<string>, key: string, cols: u16, rows: u16) -> result<client-session, string>;

    /// Queue keystrokes (prediction overlay surfaces via drain-output).
    feed-keys: async func(keys: list<u8>);

    /// Propagate a terminal resize.
    resize: async func(cols: u16, rows: u16);

    /// Drain accumulated display bytes (ANSI, pre-diffed).
    drain-output: async func() -> list<u8>;

    stats: async func() -> session-stats;

    /// The connection's current datagram ceiling (engine wire maximum
    /// is 1138 B; the embedder may assert headroom).
    max-datagram-size: async func() -> option<u32>;

    /// Stop the pumps and close the connection. The mosh session on
    /// the server survives (finding 13 governs reattach).
    detach: async func();
  }
}

/// The embedder-owned-endpoint shape (the browser client, M5): the
/// embedder binds/dials — identity persistence, bootstrap, and path
/// choice stay embedder policy — then hands the connection over; the
/// glue runs the control channel and the session, and owns the
/// connection from there (close on detach). Split from `client`
/// because this is the one function whose signature names endpoint
/// types: hosts of the composed artifact can bind against `client`
/// alone without resolving the fused-away endpoint import.
interface embed {
  use polymorph:iroh/endpoint@0.1.0.{connection};
  use client.{client-session};

  attach-proxy: async func(conn: connection, pairing-token: string, cols: u16, rows: u16) -> result<client-session, string>;
}

/// The glue component's own world (what client-core builds against).
world client-world {
  import experiment:mosh/engine;
  import polymorph:iroh/identity-generate@0.1.0;
  import polymorph:iroh/endpoint@0.1.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  export client;
  export embed;
}

/// The composed artifact as a native host sees it (bindgen view for
/// the harness; the engine and endpoint are fused inside, `embed` is
/// deliberately out of view).
world composed-client {
  export client;
}
