package experiment:mosh-proxy;

/// Host services the proxy-core component cannot provide itself: OS
/// process spawning, operator interaction, TOFU persistence, the
/// WebAuthn relying party (webauthn-rs), and the escrow store —
/// proxy-core stays protocol-only (D9).
interface host {
  record session-info {
    /// Host-assigned stable id (reattach names sessions by it).
    session-id: u64,
    /// The MOSH CONNECT key for the spawned server.
    key: string,
    /// The loopback UDP port the mosh-server listens on.
    udp-port: u16,
  }

  /// A verified reattach target.
  record reattach-info {
    /// The persistent session's mosh-server port.
    udp-port: u16,
    /// The escrowed blob, exactly as `make-persistent` stored it.
    escrow: list<u8>,
  }

  /// One WebAuthn ceremony step. Payloads are opaque webauthn-rs JSON
  /// blobs relayed from/to the client; the host holds the RP state.
  enum ceremony-kind {
    /// [] → CreationChallengeResponse JSON.
    register-start,
    /// RegisterPublicKeyCredential JSON → [] (verified + stored).
    register-finish,
    /// [] → RequestChallengeResponse JSON.
    auth-start,
    /// PublicKeyCredential JSON → [] (assertion verified).
    auth-finish,
  }

  /// Authorize a peer presenting `pairing-token`. Host policy: known
  /// peers pass; unknown peers with the valid token hit the operator
  /// TOFU prompt (and are persisted on accept); anything else is
  /// refused. `false` ⇒ the connection is closed without ceremony.
  authorize: async func(peer-id-hex: string, pairing-token: string) -> bool;

  /// Spawn `mosh-server -i 127.0.0.1` for a new session. Personal
  /// mode only (D2 interim; M7 makes it opt-in): outside it the host
  /// refuses — proxy-core also gates, this is defense in depth.
  new-session: async func() -> result<session-info, string>;

  /// Record a client-managed session (M7 inner ssh): the client
  /// started its own mosh-server on the proxy host's loopback through
  /// the forwarded ssh stream and owns the key; the host only assigns
  /// a session id and remembers the port, so passkey binding
  /// (webauthn-step / make-persistent / reattach) works unchanged.
  /// There is no proxy-side process to reap.
  register-forward: async func(udp-port: u16) -> result<u64, string>;

  /// Run one ceremony step for `session-id` (see ceremony-kind).
  webauthn-step: async func(kind: ceremony-kind, session-id: u64, payload: list<u8>) -> result<list<u8>, string>;

  /// Store the (opaque) escrow blob and mark the session persistent.
  /// Requires a completed registration for the session.
  make-persistent: async func(session-id: u64, escrow: list<u8>) -> result<_, string>;

  /// Resolve a persistent session for tunneling after a verified
  /// assertion. proxy-core only calls this after `auth-finish`
  /// succeeded for the same session on the same connection.
  reattach: async func(session-id: u64) -> result<reattach-info, string>;

  /// The session's connection ended: reclaim the server process —
  /// unless the session is persistent, in which case it survives for
  /// a future reattach. Tolerant of unknown ports: forwarded sessions
  /// (M7) have no proxy-side process, and a client-started
  /// mosh-server is the user's own, exactly like stock mosh usage.
  end-session: func(udp-port: u16);

  log: func(message: string);
}

interface proxy {
  record started {
    endpoint-id-hex: string,
    /// The endpoint's bound UDP `ip:port` (direct-path dial hint).
    direct-addr: option<string>,
  }

  /// Bind the endpoint (home relay required) and start accepting.
  /// Returns once listening; connections are served on background
  /// tasks for the instance's lifetime. `ssh-target` is the
  /// `ip:port` that SSH_FORWARD streams connect to (the shell
  /// enforces a loopback host); `personal` enables proxy-spawned
  /// sessions (D2 interim mode) — without it `NewSession` is refused
  /// and clients bring their own mosh-server over ssh (M7 posture).
  start: async func(relay-url: string, ssh-target: string, personal: bool) -> result<started, string>;
}

/// What proxy-core builds against.
world proxy-world {
  import host;
  import polymorph:iroh/identity-generate@0.1.0;
  import polymorph:iroh/endpoint@0.1.0;
  import wasi:sockets/types@0.3.0;
  export proxy;
}

/// The composed artifact (proxy-core + endpoint fused) as the native
/// shell sees it: our host interface in, the proxy surface out.
world composed-proxy {
  import host;
  export proxy;
}
