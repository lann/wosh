package experiment:spike;

/// Synchronous export probe: the shape the mosh engine needs
/// (bytes in/out, batch-of-datagrams out, stateful resource).
interface probes {
  add: func(a: s32, b: s32) -> s32;
  echo-bytes: func(data: list<u8>) -> list<u8>;
  /// Exercises Go stdlib crypto (sha256) through the toolchain.
  hash-hex: func(data: list<u8>) -> string;
  /// Shape of the engine's tick() -> outbound datagrams.
  tick-batch: func(n: u32) -> list<list<u8>>;

  /// M7 probes: the ssh engine parks x/crypto/ssh goroutines on
  /// channels across sync export calls, resuming them by feeding
  /// bytes and pumping the scheduler. spawn-parked starts a
  /// two-goroutine chain parked on unbuffered channels; poke performs
  /// the handoff and pumps; parked-result reads what the chain
  /// computed (0 until it ran).
  spawn-parked: func();
  poke: func(value: u32);
  parked-result: func() -> u32;

  /// Timer probe: a goroutine parked on Go-native time.Sleep. pump
  /// runs scheduler rounds; sleep-result reports whether the sleeper
  /// finished (0 until it did). Tells us whether ssh-internal timers
  /// merely need wall time + pumping, or freeze/trap (finding 3a was
  /// about async exports; this is the sync-world answer).
  spawn-sleeper: func(ms: u32);
  pump: func();
  sleep-result: func() -> u32;
}

interface counters {
  /// Exported resource probe: the engine wants a session resource.
  resource counter {
    constructor(start: u32);
    increment: func() -> u32;
    value: func() -> u32;
  }
}

world sync-probe {
  export probes;
  export counters;
}
